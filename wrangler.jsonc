{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "teichai-website",
  "compatibility_date": "2026-05-02",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Surfaces the "[hf] ..." fetch errors from src/lib/hf.ts in Workers Logs.
  "observability": {
    "enabled": true
  }
  // To enable ISR (see open-next.config.ts), create the resources and add:
  // "r2_buckets": [{ "binding": "NEXT_INC_CACHE_R2_BUCKET", "bucket_name": "teichai-website-cache" }],
  // "durable_objects": { "bindings": [{ "name": "NEXT_CACHE_DO_QUEUE", "class_name": "DOQueueHandler" }] },
  // "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DOQueueHandler"] }],
  // "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "teichai-website" }]
}
